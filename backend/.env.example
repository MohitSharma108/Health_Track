# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://nourish:nourish@localhost:5432/nourish?schema=public

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- AI (Anthropic) ---
# Required for food-image recognition, OCR, voice parsing, recommendations,
# daily analysis and the chat assistant. Without it, those endpoints return
# 503 with a clear "AI not configured" error — everything else still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- File storage (meal & label photos) ---
# "local" writes to ./uploads (dev only). Swap to "s3" in storageProvider.js
# for production and fill these in.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email (daily/weekly reports) ---
# "console" logs the rendered email instead of sending (dev default).
# Set to "smtp" and fill in the block below for real delivery.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nourish <reports@example.com>"

# --- Push notifications ---
# "console" logs instead of pushing (dev default). Set to "fcm" and provide
# a service-account JSON path for real push via Firebase Cloud Messaging.
PUSH_PROVIDER=console
FCM_SERVICE_ACCOUNT_PATH=

# --- Rate limiting ---
AI_RATE_LIMIT_PER_HOUR=60
AUTH_RATE_LIMIT_PER_15MIN=20
